# JIRA (required for fetching issues, comments, linked issues)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token

# Set to false if you get SSL certificate errors (e.g. corporate proxy with custom cert)
# JIRA_VERIFY_SSL=false

# Optional: OpenAI API key to generate QA challenges summary with AI (CSV column). Use --ai flag or set OPENAI_QA_SUMMARY=true
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_QA_SUMMARY=true
# OPENAI_MODEL=gpt-4o-mini
# If you get "Connection error" or SSL errors (e.g. corporate proxy), try:
# OPENAI_VERIFY_SSL=false
# OPENAI_HTTP_PROXY=http://your-proxy:port

# Optional: Gamma app – publish 10-slide PPT and get shareable URL (use --gamma-publish with --slides)
# Get API key: https://gamma.app → Account / Developer / API
# GAMMA_API_KEY=sk-gamma-...
# Set to false if you get SSL errors (e.g. corporate proxy): GAMMA_VERIFY_SSL=false

# Slack – choose one:
# Option A: Connect via API (fetch channel conversations in code)
#   Create a Slack app at https://api.slack.com/apps → OAuth & Permissions → Bot Token Scopes: channels:history (public) or groups:history (private)
#   Install app to workspace, copy "Bot User OAuth Token" (xoxb-...). Get channel ID: right-click channel → View channel details → copy ID (e.g. C01234ABC).
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL_ID=C01234ABC
# SLACK_VERIFY_SSL=false   # set if you get SSL errors (e.g. corporate proxy)
# Option B: Use file/export path (no API)
# SLACK_EXPORT_PATH=./slack_export

# QA Daily Report (daily_qa_report.py) uses SLACK_CHANNEL_ID for reading and posting (same channel).
